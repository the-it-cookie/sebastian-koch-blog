---
/**
 * The house ornament (DESIGN_august.md §4): a sprig of thyme, drawn in one
 * pass. It flanks the tagline, separates sections, and signs off an article.
 * Punctuation, not decoration — never more than three on a page.
 */

interface Props {
	/** Mirror it for the right-hand side of a pair. */
	flip?: boolean;
	width?: number;
	class?: string;
}

const { flip = false, width = 96, class: className } = Astro.props;
---

<svg
	class:list={['sprig', { 'sprig--flip': flip }, className]}
	width={width}
	height={width * 0.25}
	viewBox="0 0 96 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d="M2 13.6c13.4.9 26.6-.4 39.6-3.9 8.6-2.3 16.9-3.3 25-2.9"></path>
	<path d="M17.4 12.8c-1.9-2.5-1.7-5.4.5-7.6 1.7 2.8 1.5 5.6-.5 7.6Z"></path>
	<path d="M27.8 11.4c2-2.4 4.9-3 7.6-1.5-2.1 2.4-4.8 2.9-7.6 1.5Z"></path>
	<path d="M44.6 8.2c-1.4-2.8-.6-5.6 2-7.4 1.2 3.1.3 5.8-2 7.4Z"></path>
	<path d="M55.8 6.4c2.3-2.1 5.2-2.2 7.7-.3-2.4 2.1-5.2 2.2-7.7.3Z"></path>
	<path d="M66.6 6.8c4.4-.6 7.4 1 9 4.9-4.5.9-7.6-.7-9-4.9Z"></path>
	<path d="M78.8 8.4c3.9-1.4 7-.4 9.4 3.1"></path>
	<path d="M88.6 11.8c1.7.6 2.6 1.9 2.5 3.6-.1 1.4-1.1 2.3-2.4 2.2-1.2-.1-1.9-1-1.8-2.1.1-1 .8-1.6 1.7-1.6"></path>
</svg>

<style>
	.sprig {
		display: block;
		flex-shrink: 0;
		color: var(--calm-text);
		opacity: 0.6;
	}

	.sprig--flip {
		transform: scaleX(-1);
	}
</style>
