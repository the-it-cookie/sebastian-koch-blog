---
/**
 * DESIGN_august.md §6 — the prerequisites box at the top of a recipe.
 * This is one of the one-or-two places per page that earns the 2px emphasis
 * border. Ticks are hand-drawn, not list bullets.
 */
import Toque from './Toque.astro';
import type { Difficulty } from '../utils/difficulty';

interface Props {
	/** Licences, permissions, environments. Anything in backticks is set in mono. */
	items?: string[];
	cookingTime?: number;
	difficulty?: Difficulty;
	title?: string;
	class?: string;
}

const { items = [], cookingTime, difficulty, title = 'Ingredients', class: className } = Astro.props;

/** Splits `code spans` out of an item so they can be set in mono. */
const parts = (item: string) =>
	item.split(/(`[^`]+`)/g).map((chunk) =>
		chunk.startsWith('`') && chunk.endsWith('`')
			? { mono: true, text: chunk.slice(1, -1) }
			: { mono: false, text: chunk },
	);
---

<section class:list={['ingredients', className]} aria-label={title}>
	<header class="ingredients__head">
		<p class="label">{title}</p>
		<p class="ingredients__meta meta">
			{cookingTime && <span>Cooking time {cookingTime} min</span>}
			{difficulty && <Toque level={difficulty} />}
		</p>
	</header>

	<ul class="ingredients__list">
		{
			items.map((item) => (
				<li>
					<svg
						class="ingredients__tick"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M3.4 10.8c1.8 1.1 3.2 2.5 4.3 4.2 2.4-5 5.4-8.8 9-11.4" />
					</svg>
					<span>
						{parts(item).map((chunk) => (chunk.mono ? <code>{chunk.text}</code> : chunk.text))}
					</span>
				</li>
			))
		}
	</ul>

	<slot />
</section>

<style>
	.ingredients {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.5rem;
		border: 2px solid var(--emphasis-border);
		border-radius: var(--radius-md);
		background: var(--bg);
	}

	.ingredients__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.ingredients__meta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.ingredients__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.ingredients__list li {
		display: flex;
		align-items: flex-start;
		gap: 0.625rem;
	}

	.ingredients__tick {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		margin-top: 0.35em;
		color: var(--calm-text);
	}
</style>
