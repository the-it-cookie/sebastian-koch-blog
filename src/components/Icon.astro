---
/**
 * UI icon layer (DESIGN_august.md §4a): Lucide geometry, stroke-width 1.75,
 * round caps, currentColor. The paths are inlined rather than pulled from
 * `lucide-astro` so the site ships exactly the dozen icons it uses and takes on
 * no runtime dependency.
 */

interface Props {
	name: keyof typeof PATHS;
	size?: number;
	class?: string;
	/** Only pass this for icon-only controls; decorative icons stay hidden. */
	label?: string;
}

const PATHS = {
	search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
	menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
	close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
	sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
	moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
	'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
	'arrow-up-right': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
	'chevron-right': '<path d="m9 18 6-6-6-6"/>',
	'chevron-left': '<path d="m15 18-6-6 6-6"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
	linkedin:
		'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
	mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
	reply: '<path d="m15 10 5 5-5 5"/><path d="M4 4v7a4 4 0 0 0 4 4h12"/>',
} as const;

const { name, size = 20, class: className, label } = Astro.props;
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	set:html={PATHS[name]}
/>

<style>
	.icon {
		display: block;
		flex-shrink: 0;
	}
</style>
