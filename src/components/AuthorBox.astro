---
/**
 * DESIGN_august.md §6 — 64px round avatar, name as h3, two lines of bio, social.
 */
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';
import Icon from './Icon.astro';
import { AUTHOR_IDENTITY_LINE, AUTHOR_NAME, LINKEDIN_URL } from '../consts';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<aside class:list={['author', className]}>
	<Image src={profilePhoto} alt={AUTHOR_NAME} width={128} height={128} class="author__avatar" />
	<div class="author__body">
		{/* A name, not a section heading — and an <h3> here would skip a level on
		    posts whose body has no <h2>. */}
		<p class="author__name">{AUTHOR_NAME}</p>
		<p class="small author__bio">{AUTHOR_IDENTITY_LINE}</p>
		<div class="author__links">
			<a href="/about">More about me</a>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Sebastian Koch on LinkedIn</span>
				<Icon name="linkedin" size={18} />
			</a>
		</div>
	</div>
</aside>

<style>
	.author {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		padding: 1.5rem;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.author :global(.author__avatar) {
		width: 64px;
		height: 64px;
		border-radius: var(--radius-full);
		object-fit: cover;
		flex-shrink: 0;
	}

	.author__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.author__name {
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.author__bio {
		color: var(--text-soft);
	}

	.author__links {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.author__links a {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: var(--signal-text);
	}
</style>
