---
/**
 * One step inside <Method>. The number sits in its own 3rem column with a
 * hairline running down from it to the next step (DESIGN_august.md §6).
 */

interface Props {
	title: string;
	class?: string;
}

const { title, class: className } = Astro.props;
---

<li class:list={['step', className]}>
	<div class="step__body">
		<h3 class="step__title">{title}</h3>
		<div class="step__content"><slot /></div>
	</div>
</li>

<style>
	.step {
		position: relative;
		counter-increment: step;
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
	}

	.step::before {
		content: counter(step);
		grid-column: 1;
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1;
		color: var(--signal);
	}

	/* The rule that carries the eye to the next step. The last step has no
	   next step, so it gets no line. */
	.step::after {
		content: '';
		position: absolute;
		left: 1.5rem;
		top: 2.6rem;
		bottom: -2.5rem;
		width: 1px;
		background: var(--hairline);
	}

	.step:last-child::after {
		display: none;
	}

	.step__body {
		grid-column: 2;
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		min-width: 0;
	}

	.step__content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (max-width: 480px) {
		.step {
			grid-template-columns: 2.25rem 1fr;
			gap: 0.75rem;
		}

		.step::before {
			font-size: 1.625rem;
		}

		.step::after {
			left: 1.125rem;
		}
	}
</style>
