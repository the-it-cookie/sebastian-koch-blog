---
/**
 * DESIGN_august.md §6 — two rows, no mega menu.
 *
 * Row 1  wordmark · tagline flanked by sprigs (lg and up) · actions
 * Row 2  the sage band carrying five mono nav labels
 *
 * Past 120px of scroll row 1 folds away and the band takes over, carrying a
 * compact wordmark. Below md the band collapses to a burger that opens a
 * full-height <dialog> — which buys the focus trap and Esc handling for free.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import SearchOverlay from './SearchOverlay.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import Sprig from './ornaments/Sprig.astro';
import { LINKEDIN_URL, SITE_TAGLINE } from '../consts';

const NAV = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Cookbook' },
	{ href: '/tags', label: 'Topics' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-header" id="site-header">
	<div class="header-top-wrap">
		<div class="header-top">
			<div class="container header-top__inner">
				<Wordmark />

				<p class="header-tagline">
					<Sprig width={72} />
					<span>{SITE_TAGLINE}</span>
					<Sprig width={72} flip />
				</p>

				<div class="header-actions">
					<a
						class="header-icon-link"
						href={LINKEDIN_URL}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="sr-only">Sebastian Koch on LinkedIn</span>
						<Icon name="linkedin" size={20} />
					</a>
					<button type="button" class="header-icon-link" data-search-open aria-label="Search">
						<Icon name="search" size={20} />
					</button>
					<ThemeToggle />
					<Button variant="primary" href="/contact" class="header-cta">Get in touch</Button>
				</div>
			</div>
		</div>
	</div>

	<div class="header-band">
		<div class="container header-band__inner">
			<Wordmark variant="compact" class="header-band__mark" />

			<nav class="header-nav" aria-label="Primary">
				{
					NAV.map((item) => (
						<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>

			<button
				type="button"
				class="header-burger"
				data-menu-open
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<Icon name="menu" size={24} />
			</button>
		</div>
	</div>
</header>

<dialog class="mobile-menu" id="mobile-menu">
	<div class="mobile-menu__bar">
		<Wordmark variant="compact" />
		<button type="button" class="header-icon-link" data-menu-close aria-label="Close menu">
			<Icon name="close" size={24} />
		</button>
	</div>
	<nav class="mobile-menu__nav" aria-label="Primary">
		{
			NAV.map((item) => (
				<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
	<div class="mobile-menu__foot">
		<Button variant="primary" href="/contact">Get in touch</Button>
		<a class="header-icon-link" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
			<span class="sr-only">Sebastian Koch on LinkedIn</span>
			<Icon name="linkedin" size={20} />
		</a>
	</div>
</dialog>

<SearchOverlay />

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--bg);
	}

	/* Row 1 folds away by collapsing its grid row — no magic pixel heights. */
	.header-top-wrap {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows var(--dur-base) var(--ease-out);
	}

	.site-header.is-condensed .header-top-wrap {
		grid-template-rows: 0fr;
	}

	.header-top {
		overflow: hidden;
	}

	.header-top__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.25rem;
		min-width: 0;
	}

	@media (min-width: 768px) {
		.header-top__inner {
			gap: 1.5rem;
		}
	}

	.header-tagline {
		display: none;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		color: var(--text-soft);
		white-space: nowrap;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	/* Below md the CTA and the social link live in the mobile panel instead —
	   leaving them in row 1 pushes the whole page wider than the viewport.
	   .header-cta needs :global because it lands on a child component's root. */
	.header-actions :global(.header-cta),
	.header-actions > .header-icon-link:first-child {
		display: none;
	}

	@media (min-width: 768px) {
		.header-actions :global(.header-cta),
		.header-actions > .header-icon-link:first-child {
			display: inline-flex;
		}
	}

	.header-icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: none;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--text-soft);
		cursor: pointer;
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.header-icon-link:hover {
		color: var(--signal-text);
	}

	/* :global is required for classes handed to a child component — Astro scopes
	   styles to this file's own elements and does not stamp its scope id onto a
	   component's root node. */
	@media (min-width: 768px) {
		.header-actions :global(.header-cta) {
			margin-left: 0.5rem;
		}
	}

	/* --- Row 2: the sage band --- */
	.header-band {
		background: var(--calm);
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
	}

	.header-band__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-block: 0.5rem;
	}

	.header-band__inner :global(.header-band__mark) {
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--dur-base) var(--ease-out);
		justify-self: start;
	}

	.site-header.is-condensed .header-band__inner :global(.header-band__mark) {
		opacity: 1;
		pointer-events: auto;
	}

	.header-nav {
		display: none;
		grid-column: 2;
		align-items: center;
		gap: 2.5rem;
	}

	.header-nav a {
		position: relative;
		padding-block: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--calm-text);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.header-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.35rem;
		height: 2px;
		background: var(--signal);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 180ms var(--ease-out);
	}

	.header-nav a:hover,
	.header-nav a[aria-current='page'] {
		color: var(--signal-text);
	}

	.header-nav a:hover::after,
	.header-nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.header-burger {
		grid-column: 3;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: none;
		background: transparent;
		border-radius: var(--radius-sm);
		color: var(--calm-text);
		cursor: pointer;
	}

	@media (min-width: 768px) {
		.header-nav {
			display: flex;
			justify-self: center;
		}

		.header-burger {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.header-tagline {
			display: flex;
		}
	}

	/* --- Mobile panel --- */
	.mobile-menu {
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0;
		border: none;
		background: var(--bg);
		color: var(--text);
	}

	.mobile-menu::backdrop {
		background: rgb(26 21 32 / 0.6);
	}

	.mobile-menu[open] {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.mobile-menu__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.25rem 20px;
		border-bottom: 1px solid var(--hairline);
	}

	.mobile-menu__nav {
		display: flex;
		flex-direction: column;
		padding-inline: 20px;
	}

	.mobile-menu__nav a {
		padding-block: 0.75rem;
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--text);
		border-bottom: 1px solid var(--hairline);
	}

	.mobile-menu__nav a[aria-current='page'] {
		color: var(--signal-text);
	}

	.mobile-menu__foot {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 20px 2rem;
	}
</style>

<script>
	const header = document.getElementById('site-header');
	const topRow = header?.querySelector<HTMLElement>('.header-top__inner');
	const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
	const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

	/**
	 * Sticky condense (§6).
	 *
	 * Collapsing row 1 shortens the document, and the browser answers that by
	 * pulling scrollY down by row 1's height — scroll anchoring keeps the content
	 * visually put, and near the page end the scroll maximum clamps as well. With
	 * one threshold that correction lands back *below* it, so the header expands,
	 * the correction reverses, and the band shivers between the two states.
	 *
	 * Two thresholds more than a row-height apart make each state stable against
	 * its own correction (and against trackpad jitter around the boundary).
	 */
	const EXPAND_AT = 32;
	let condenseAt = 120;

	// Row 1 keeps its natural height even while collapsed — the grid row is 0fr
	// and .header-top clips it — so this measures the same in both states.
	const measure = () => {
		condenseAt = Math.max(120, (topRow?.offsetHeight ?? 0) + EXPAND_AT * 2);
	};

	const sync = () => {
		const condensed = header?.classList.contains('is-condensed') ?? false;
		const y = window.scrollY;
		if (condensed ? y < EXPAND_AT : y > condenseAt) {
			header?.classList.toggle('is-condensed', !condensed);
		}
	};

	// rAF-throttled so the scroll handler never does layout work more than once
	// a frame.
	let ticking = false;
	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			sync();
			ticking = false;
		});
	};
	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', () => {
		measure();
		sync();
	});
	measure();
	sync();

	openBtn?.addEventListener('click', () => {
		menu?.showModal();
		openBtn.setAttribute('aria-expanded', 'true');
	});

	document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu?.close());

	menu?.addEventListener('close', () => openBtn?.setAttribute('aria-expanded', 'false'));

	// A tap on a nav entry should close the panel before the navigation lands,
	// otherwise a back-navigation restores the page with the dialog still open.
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
</script>
