---
/**
 * Difficulty, measured in chef's hats (DESIGN_august.md §5).
 * easy = 1 · medium = 2 · advanced = 3.
 */

import { DIFFICULTY_TOQUES, type Difficulty } from '../utils/difficulty';

interface Props {
	level: Difficulty;
	class?: string;
}

const { level, class: className } = Astro.props;
const filled = DIFFICULTY_TOQUES[level] ?? 2;
---

<span class:list={['toque', className]}>
	<span class="toque__hats" aria-hidden="true">
		{
			[1, 2, 3].map((n) => (
				<svg
					class:list={['toque__hat', { 'is-off': n > filled }]}
					width="14"
					height="14"
					viewBox="0 0 20 16"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M5.1 8.9C3.2 8.6 2 7.1 2.3 5.4 2.6 3.7 4.2 2.7 5.9 3 6.5 1.4 8.2.4 10.1.6c1.8.2 3.3 1.4 3.6 2.9 1.7-.2 3.3 1 3.5 2.7.2 1.7-.9 3.1-2.6 3.4" />
					<path d="M5.2 8.8c.2 1.6.3 3.2.2 4.8 3.1.5 6.2.5 9.3 0-.2-1.6-.1-3.2.1-4.8" />
				</svg>
			))
		}
	</span>
	<span class="toque__label">{level}</span>
</span>

<style>
	.toque {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--text-soft);
	}

	.toque__hats {
		display: inline-flex;
		gap: 0.1rem;
		color: var(--calm-text);
	}

	.toque__hat.is-off {
		opacity: 0.28;
	}
</style>
