---
/**
 * DESIGN_august.md §6 — the recipe card.
 *
 * Image 16:10 on top, then chip, title with its italic accent, a two-line
 * teaser, and a meta row carrying cooking time and difficulty. The title link
 * is stretched across the card so the whole thing is clickable, while the chip
 * keeps its own stacking context and stays independently reachable.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AccentHeading from './AccentHeading.astro';
import CategoryIcon from './CategoryIcon.astro';
import CategoryChip from './CategoryChip.astro';
import Toque from './Toque.astro';
import type { Difficulty } from '../utils/difficulty';

interface Props {
	title: string;
	accent?: string;
	description: string;
	url: string;
	tags?: string[];
	heroImage?: ImageMetadata;
	readingTime: number;
	difficulty?: Difficulty;
	draft?: boolean;
	headingLevel?: 'h2' | 'h3';
	class?: string;
}

const {
	title,
	accent,
	description,
	url,
	tags = [],
	heroImage,
	readingTime,
	difficulty,
	draft = false,
	headingLevel = 'h3',
	class: className,
} = Astro.props;

const topic = tags[0];
---

<article class:list={['card', className]}>
	<div class="card__media">
		{
			heroImage ? (
				<Image src={heroImage} alt="" width={640} height={400} loading="lazy" />
			) : (
				<div class="card__placeholder">
					<CategoryIcon topic={topic ?? ''} size={64} />
				</div>
			)
		}
	</div>

	<div class="card__body">
		<div class="card__chips">
			{topic && <CategoryChip topic={topic} />}
			{draft && <span class="card__draft label">Draft</span>}
		</div>

		<AccentHeading text={title} accent={accent} as={headingLevel} class="card__title" />

		<p class="card__teaser small">{description}</p>

		<p class="card__meta meta">
			<span>Cooking time {readingTime} min</span>
			{difficulty && <Toque level={difficulty} />}
		</p>

		<a class="card__link" href={url}>
			<span class="sr-only">Read {title}</span>
		</a>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			border-color var(--dur-base) var(--ease-out);
	}

	.card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-hover);
		border-color: var(--signal);
	}

	.card__media {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg-band);
		border-bottom: 1px solid var(--hairline);
	}

	.card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.card:hover .card__media :global(img) {
		transform: scale(1.03);
	}

	/* §4 — a placeholder is the ground plus the category drawing at 20%.
	   Never a drawn fake photograph. */
	.card__placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text);
		opacity: 0.2;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		flex: 1;
	}

	.card__chips {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		position: relative;
		z-index: 1;
	}

	.card__draft {
		padding: 0.25rem 0.6rem;
		border-radius: var(--radius-full);
		background: var(--highlight-soft);
		color: var(--text);
	}

	.card :global(.card__title) {
		transition: color var(--dur-base) var(--ease-out);
	}

	.card:hover :global(.card__title) {
		color: var(--signal-text);
	}

	.card__teaser {
		color: var(--text-soft);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card__meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: auto;
		padding-top: 0.25rem;
	}

	.card__link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
</style>
