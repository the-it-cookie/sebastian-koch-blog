---
/**
 * Many things pointing at few things. Used for the "twelve forms, one script"
 * argument, where the count is the whole point — so the items are rendered
 * individually rather than summarised as a number.
 */

interface Props {
	groups: { label: string; items: string[] }[];
	targets: string[];
	class?: string;
}

const { groups, targets, class: className } = Astro.props;
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<div class:list={['fanin', className]}>
	<div class="fanin__sources">
		{
			groups.map((group) => (
				<section class="fanin__group">
					<p class="label fanin__group-label">{group.label}</p>
					<ul class="fanin__items">
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>
			))
		}
	</div>

	<div class="fanin__join" aria-hidden="true">
		<span class="fanin__count">{total} &rarr;</span>
	</div>

	<ul class="fanin__targets">
		{targets.map((target) => <li><code>{target}</code></li>)}
	</ul>
</div>

<style>
	.fanin {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: 1.25rem;
	}

	@media (min-width: 700px) {
		.fanin {
			grid-template-columns: 1fr auto 1fr;
			gap: 1.5rem;
		}
	}

	.fanin__sources {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.fanin__group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.75rem;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-sm);
		background: var(--bg);
	}

	.fanin__group-label {
		color: var(--calm-text);
	}

	.fanin__items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.fanin__items li {
		font-size: 0.8125rem;
		line-height: 1.3;
		padding: 0.25rem 0.4rem;
		border-radius: 3px;
		background: var(--bg-band);
		color: var(--text-soft);
		text-align: center;
	}

	.fanin__join {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.fanin__count {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--text-soft);
		white-space: nowrap;
	}

	.fanin__targets {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.fanin__targets li {
		padding: 0.75rem 1rem;
		border: 2px solid var(--emphasis-border);
		border-radius: var(--radius-sm);
		background: var(--bg);
		text-align: center;
	}

	.fanin__targets code {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		background: none;
		padding: 0;
		overflow-wrap: anywhere;
	}
</style>
