---
/**
 * The intended route along the top, the detection path underneath. The two are
 * deliberately not drawn as one graph: the dotted edges are not part of the
 * workflow, they exist so that a departure from it becomes visible.
 */
import FlowChain from './FlowChain.astro';
import type { ChainStep } from './types';

interface Props {
	steps: ChainStep[];
	returns: { label: string; text: string }[];
	class?: string;
}

const { steps, returns, class: className } = Astro.props;
---

<div class:list={['pipeline', className]}>
	<FlowChain steps={steps} direction="row" />

	<ul class="pipeline__returns">
		{
			returns.map((entry) => (
				<li class="pipeline__return">
					<span class="label pipeline__return-label">{entry.label}</span>
					<span class="pipeline__return-text">{entry.text}</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.pipeline {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.pipeline__returns {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.pipeline__return {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.75rem 1rem;
		border: 1px dashed var(--hairline);
		border-radius: var(--radius-sm);
	}

	.pipeline__return-label {
		color: var(--text-soft);
	}

	.pipeline__return-text {
		font-size: 0.9375rem;
		line-height: 1.45;
	}
</style>
