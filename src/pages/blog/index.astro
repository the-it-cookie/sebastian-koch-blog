---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getReadingTime } from '../../utils/readingTime';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const posts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({ ...post, readingTime: getReadingTime(post.body ?? '') }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="Articles on Power Platform, Dynamics 365, AI and GDPR-compliant consent architecture." />
		<style>
			main {
				width: 720px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 2.5em;
			}
			li a {
				text-decoration: none;
			}
			li a:hover .title {
				color: var(--accent);
			}
			.title {
				margin: 0 0 0.2em 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.description {
				margin: 0.3em 0;
				color: rgb(var(--gray-dark));
			}
			.draft-badge {
				display: inline-block;
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.7em;
				text-transform: uppercase;
				vertical-align: middle;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h2 class="title">
										{post.data.title}
										{post.data.draft && <span class="draft-badge">Draft</span>}
									</h2>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} /> &middot; {post.readingTime} min
										read
									</p>
									<p class="description">{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<ul class="tag-list">
											{post.data.tags.map((tag) => (
												<li>{tag}</li>
											))}
										</ul>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
