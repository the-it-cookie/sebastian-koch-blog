---
/**
 * All topics — the same grid the home page uses, at full length.
 */
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { slugifyTag } from '../../utils/slugify';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();

const counts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const topics = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title={`Topics | ${SITE_TITLE}`} description="Browse every recipe by topic.">
	<div class="page-head">
		<div class="container page-head__inner">
			<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Topics' }]} />
			<p class="label">The menu</p>
			<h1>Every section of the <em>kitchen</em></h1>
			<p class="lead">
				Same chip, different drawing. Pick the corner you are working in and the recipes filed
				there come up.
			</p>
		</div>
	</div>

	<section class="section">
		<div class="container">
			<div class="topics-grid reveal">
				{
					topics.map(([tag, count]) => (
						<a class="topic" href={`/tags/${slugifyTag(tag)}/`}>
							<CategoryIcon topic={tag} size={40} class="topic__icon" />
							<span class="label topic__name">{tag}</span>
							<span class="meta">
								{count} {count === 1 ? 'recipe' : 'recipes'}
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<CtaPanel />
</BaseLayout>

<style>
	.page-head {
		background: var(--calm);
		padding-block: 3rem 3.5rem;
	}

	.page-head__inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 62ch;
	}

	.topics-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background: var(--hairline);
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	@media (min-width: 768px) {
		.topics-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.topic {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 2rem 1rem;
		background: var(--bg);
		text-align: center;
		text-decoration: none;
		color: var(--text);
		transition: background-color var(--dur-base) var(--ease-out);
	}

	.topic:hover {
		background: var(--calm);
		color: var(--text);
	}

	.topic :global(.topic__icon) {
		color: var(--calm-text);
		transition: color var(--dur-base) var(--ease-out);
	}

	.topic:hover :global(.topic__icon) {
		color: var(--signal);
	}

	.topic__name {
		color: var(--text);
	}
</style>
