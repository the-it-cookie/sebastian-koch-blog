---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { slugifyTag } from '../../utils/slugify';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
	const tagNames = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tagNames.map((tagName) => ({
		params: { tag: slugifyTag(tagName) },
		props: {
			tagName,
			posts: posts
				.filter((post) => post.data.tags.includes(tagName))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tagName, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${tagName} | ${SITE_TITLE}`}
			description={`Articles tagged with ${tagName}.`}
		/>
		<style>
			main {
				width: 720px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 2em;
			}
			li a {
				text-decoration: none;
			}
			li a:hover .title {
				color: var(--accent);
			}
			.title {
				margin: 0 0 0.2em 0;
				color: rgb(var(--black));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Tag: {tagName}</h1>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h2 class="title">{post.data.title}</h2>
								<p class="meta">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
