---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, AUTHOR_POSITIONING, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2em 0 3em 0;
			}
			.hero h1 {
				margin-bottom: 0.2em;
			}
			.hero p.positioning {
				margin: 0;
				font-size: 1.25em;
				color: rgb(var(--gray-dark));
			}
			.hero p.tagline {
				margin: 0.8em 0 0 0;
				font-style: italic;
				color: rgb(var(--gray));
			}
			h2.section-title {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding-bottom: 0.3em;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 2em;
			}
			li a {
				text-decoration: none;
			}
			li a:hover .title {
				color: var(--accent);
			}
			.title {
				margin: 0 0 0.2em 0;
				color: rgb(var(--black));
			}
			.description {
				margin: 0.3em 0 0 0;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{AUTHOR_NAME}</h1>
				<p class="positioning">{AUTHOR_POSITIONING}</p>
				<p class="tagline">{SITE_TAGLINE}</p>
			</section>
			<section>
				<h2 class="section-title">Latest articles</h2>
				<ul>
					{
						latestPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3 class="title">{post.data.title}</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
