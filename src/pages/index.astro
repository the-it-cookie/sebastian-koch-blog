---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2em 0 3em 0;
			}
			.hero h1 {
				margin-bottom: 0.4em;
			}
			.hero p.intro {
				margin: 0;
				font-size: 1.25em;
				color: rgb(var(--gray-dark));
			}
			.hero p.pointer {
				margin: 0.8em 0 0 0;
				font-size: 0.95em;
				color: rgb(var(--gray));
			}
			h2.section-title {
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.3em;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{AUTHOR_NAME}</h1>
				<p class="intro">
					I collect my CRM and Power Platform recipes here — hope you find something worth
					tasting, too :)
				</p>
				<p class="pointer">
					New here? <a href="/about">The About page</a> or
					<a href="/blog/why-this-site-is-a-cookbook/">the first recipe</a> will give you a feel
					for what this is.
				</p>
			</section>
			<section>
				<h2 class="section-title">Fresh from the kitchen</h2>
				<ul>
					{
						latestPosts.map((post) => (
							<li>
								<a class="card" href={`/blog/${post.id}/`}>
									<h3 class="title">{post.data.title}</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
