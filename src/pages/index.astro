---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { slugifyTag } from '../utils/slugify';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const topics = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2em 0 3em 0;
			}
			.hero h1 {
				margin-bottom: 0.4em;
			}
			.hero p.intro {
				margin: 0;
				font-size: 1.25em;
				color: rgb(var(--gray-dark));
			}
			.hero p.pointer {
				margin: 0.8em 0 0 0;
				font-size: 0.95em;
				color: rgb(var(--gray));
			}
			h2.section-title {
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.3em;
			}
			.topics {
				margin-top: 2.5em;
			}
			ul.post-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{AUTHOR_NAME}</h1>
				<p class="intro">
					I collect my CRM and Power Platform recipes here, hope you find something worth
					tasting, too :)
				</p>
				<p class="pointer">
					New here? <a href="/about">The About page</a> or{' '}
					<a href="/blog/why-this-site-is-a-cookbook/">the first recipe</a> will give you a feel
					for what this is.
				</p>
			</section>
			<section>
				<h2 class="section-title">Fresh from the kitchen</h2>
				<ul class="post-list">
					{
						latestPosts.map((post) => (
							<li>
								<div class="card">
									<h3 class="title">
										<a class="card-link" href={`/blog/${post.id}/`}>
											{post.data.title}
										</a>
									</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<ul class="tag-list">
											{post.data.tags.map((tag) => (
												<li>
													<a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
												</li>
											))}
										</ul>
									)}
									<p class="read-more">
										Read article <span class="arrow">&rarr;</span>
									</p>
								</div>
							</li>
						))
					}
				</ul>
			</section>
			{
				topics.length > 0 && (
					<section class="topics">
						<h2 class="section-title">Browse by topic</h2>
						<ul class="tag-list">
							{topics.map(([tag, count]) => (
								<li>
									<a href={`/tags/${slugifyTag(tag)}/`}>
										{tag} ({count})
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
