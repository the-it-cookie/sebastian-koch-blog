---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, TURNSTILE_SITE_KEY } from '../consts';

const TOPICS = ['General question', 'Collaboration', 'Speaking / MVP', 'Feedback', 'Other'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${AUTHOR_NAME}`}
			description="Get in touch: general questions, collaboration, speaking, or feedback."
		/>
	</head>
	<body>
		<Header />
		<main class="prose">
			<h1>Contact</h1>
			<p>
				Got a question, a collaboration idea, or feedback on something I wrote? Use the form
				below — I read everything myself.
			</p>

			<form id="contact-form">
				<label for="contact-name">Name</label>
				<input id="contact-name" name="name" required maxlength="80" autocomplete="name" />

				<label for="contact-email">Email</label>
				<input
					id="contact-email"
					name="email"
					type="email"
					required
					maxlength="200"
					autocomplete="email"
				/>

				<label for="contact-topic">Topic</label>
				<select id="contact-topic" name="topic" required>
					{TOPICS.map((topic) => <option value={topic}>{topic}</option>)}
				</select>
				<input
					id="contact-topic-other"
					name="topicOther"
					placeholder="What's it about?"
					maxlength="120"
					hidden
				/>

				<label for="contact-message">Message</label>
				<textarea id="contact-message" name="message" required maxlength="5000" rows="7"
				></textarea>

				<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
				<button type="submit">Send message</button>
				<p id="form-message" class="meta"></p>
			</form>
		</main>
		<Footer />
	</body>
</html>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
	main.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
		color: rgb(var(--gray-dark));
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		max-width: 480px;
		margin-top: 2em;
	}
	label {
		font-family: var(--font-mono);
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	input,
	select,
	textarea {
		font-family: var(--font-sans);
		font-size: 1em;
		padding: 0.5em;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		color: rgb(var(--gray-dark));
	}
	button[type='submit'] {
		align-self: flex-start;
		font-family: var(--font-mono);
		padding: 0.5em 1.25em;
		border-radius: 6px;
		border: 1px solid var(--accent);
		background: var(--accent);
		color: #fff;
		cursor: pointer;
	}
	button[type='submit']:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
	}
</style>

<script>
	declare const turnstile: {
		reset: (widget?: string | HTMLElement) => void;
		getResponse: (widget?: string | HTMLElement) => string | undefined;
	};

	const form = document.getElementById('contact-form') as HTMLFormElement;
	const nameInput = document.getElementById('contact-name') as HTMLInputElement;
	const emailInput = document.getElementById('contact-email') as HTMLInputElement;
	const topicSelect = document.getElementById('contact-topic') as HTMLSelectElement;
	const topicOtherInput = document.getElementById('contact-topic-other') as HTMLInputElement;
	const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
	const formMessage = document.getElementById('form-message') as HTMLParagraphElement;

	topicSelect.addEventListener('change', () => {
		const isOther = topicSelect.value === 'Other';
		topicOtherInput.hidden = !isOther;
		topicOtherInput.required = isOther;
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		formMessage.textContent = '';

		const turnstileToken = turnstile?.getResponse();
		if (!turnstileToken) {
			formMessage.textContent = 'Please complete the captcha.';
			return;
		}

		const topic =
			topicSelect.value === 'Other' && topicOtherInput.value.trim()
				? topicOtherInput.value.trim()
				: topicSelect.value;

		const payload = {
			name: nameInput.value.trim(),
			email: emailInput.value.trim(),
			topic,
			message: messageInput.value.trim(),
			turnstileToken,
		};

		const res = await fetch('/api/contact', {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify(payload),
		});
		const data = await res.json();

		if (!res.ok) {
			formMessage.textContent = data.error ?? 'Something went wrong.';
			turnstile?.reset();
			return;
		}

		formMessage.textContent = data.message;
		form.reset();
		topicOtherInput.hidden = true;
		turnstile?.reset();
	});
</script>
