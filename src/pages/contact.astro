---
import Breadcrumb from '../components/Breadcrumb.astro';
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME, TURNSTILE_SITE_KEY } from '../consts';

const TOPICS = ['General question', 'Collaboration', 'Speaking / MVP', 'Feedback', 'Other'];
---

<BaseLayout
	title={`Contact | ${AUTHOR_NAME}`}
	description="Get in touch: general questions, collaboration, speaking, or feedback."
>
	<div class="page-head">
		<div class="container page-head__inner">
			<Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
			<p class="label">Pass a note to the kitchen</p>
			<h1>Say <em>hello</em></h1>
			<p class="lead">
				A question, a collaboration idea, or feedback on something I wrote — it all lands in the
				same inbox, and I read every message myself.
			</p>
		</div>
	</div>

	<section class="section">
		<div class="container contact">
			<form id="contact-form" class="contact__form">
				<div class="field">
					<label for="contact-name">Name</label>
					<input id="contact-name" name="name" required maxlength="80" autocomplete="name" />
				</div>

				<div class="field">
					<label for="contact-email">Email</label>
					<input
						id="contact-email"
						name="email"
						type="email"
						required
						maxlength="200"
						autocomplete="email"
					/>
				</div>

				<div class="field">
					<label for="contact-topic">Topic</label>
					<select id="contact-topic" name="topic" required>
						{TOPICS.map((topic) => <option value={topic}>{topic}</option>)}
					</select>
					<input
						id="contact-topic-other"
						name="topicOther"
						placeholder="What's it about?"
						maxlength="120"
						hidden
					/>
				</div>

				<div class="field">
					<label for="contact-message">Message</label>
					<textarea id="contact-message" name="message" required maxlength="5000" rows="7"
					></textarea>
				</div>

				<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>

				<div class="contact__submit">
					<Button variant="primary" type="submit">Send message</Button>
					<p id="form-message" class="meta"></p>
				</div>
			</form>

			<aside class="contact__aside">
				<p class="label">What happens next</p>
				<p class="small">
					Messages go straight to my personal inbox — no autoresponder, no CRM sequence. I usually
					reply within a few days.
				</p>
				<p class="small">
					Your name, email and message are stored only as long as it takes to answer you. The
					captcha is Cloudflare Turnstile; the <a href="/privacy">privacy policy</a> explains what
					it does.
				</p>
			</aside>
		</div>
	</section>
</BaseLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
	.page-head {
		background: var(--calm);
		padding-block: 3rem 3.5rem;
	}

	.page-head__inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 62ch;
	}

	.contact {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: start;
	}

	@media (min-width: 900px) {
		.contact {
			grid-template-columns: minmax(0, 32rem) minmax(0, 22rem);
			gap: 4rem;
		}
	}

	.contact__form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.contact__submit {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.contact__aside {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		background: var(--bg-band);
		color: var(--text-soft);
	}
</style>

<script>
	declare const turnstile: {
		reset: (widget?: string | HTMLElement) => void;
		getResponse: (widget?: string | HTMLElement) => string | undefined;
	};

	const form = document.getElementById('contact-form') as HTMLFormElement;
	const nameInput = document.getElementById('contact-name') as HTMLInputElement;
	const emailInput = document.getElementById('contact-email') as HTMLInputElement;
	const topicSelect = document.getElementById('contact-topic') as HTMLSelectElement;
	const topicOtherInput = document.getElementById('contact-topic-other') as HTMLInputElement;
	const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
	const formMessage = document.getElementById('form-message') as HTMLParagraphElement;

	topicSelect.addEventListener('change', () => {
		const isOther = topicSelect.value === 'Other';
		topicOtherInput.hidden = !isOther;
		topicOtherInput.required = isOther;
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		formMessage.textContent = '';

		const turnstileToken = turnstile?.getResponse();
		if (!turnstileToken) {
			formMessage.textContent = 'Please complete the captcha.';
			return;
		}

		const topic =
			topicSelect.value === 'Other' && topicOtherInput.value.trim()
				? topicOtherInput.value.trim()
				: topicSelect.value;

		const payload = {
			name: nameInput.value.trim(),
			email: emailInput.value.trim(),
			topic,
			message: messageInput.value.trim(),
			turnstileToken,
		};

		const res = await fetch('/api/contact', {
			method: 'POST',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify(payload),
		});
		const data = await res.json();

		if (!res.ok) {
			formMessage.textContent = data.error ?? 'Something went wrong.';
			turnstile?.reset();
			return;
		}

		formMessage.textContent = data.message;
		form.reset();
		topicOtherInput.hidden = true;
		turnstile?.reset();
	});
</script>
