---
import Button from '../components/Button.astro';
import Sprig from '../components/ornaments/Sprig.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Page not found | ${SITE_TITLE}`}
	description="This page could not be found."
>
	<section class="section not-found">
		<div class="container not-found__inner">
			<Sprig width={110} />
			<p class="label">Error 404</p>
			<h1>This dish is <em>not</em> on the menu</h1>
			<p class="lead">
				The page you were after has been moved, renamed, or never made it out of the test kitchen.
			</p>
			<div class="not-found__actions">
				<Button variant="primary" href="/blog">Browse the cookbook</Button>
				<Button variant="ghost" href="/">Back to the front page</Button>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		padding-block: 3rem;
	}

	.not-found .lead {
		max-width: 48ch;
	}

	.not-found__actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 0.5rem;
	}
</style>
